sum_mpi.c

#include <stdio.h>
#include <mpi.h>

int main(int argc, char *argv[]) {
    int rank, size;

    int arr[] = {1,2,3,4,5,6,7,8};
    int n = sizeof(arr) / sizeof(arr[0]);

    int local_sum = 0, total_sum = 0;

    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    int chunk = n / size;
    int start = rank * chunk;
    int end = (rank == size - 1) ? n : start + chunk;

    for (int i = start; i < end; i++) {
        local_sum += arr[i];
    }

    printf("Processor %d: Intermediate Sum = %d\n", rank, local_sum);

    MPI_Reduce(&local_sum, &total_sum, 1, MPI_INT, MPI_SUM, 0, MPI_COMM_WORLD);

    if (rank == 0) {
        printf("Final Sum = %d\n", total_sum);
    }

    MPI_Finalize();
    return 0;
}




sum_openmp.c
#include <stdio.h>
#include <omp.h>

int main() {
    int arr[] = {1,2,3,4,5,6,7,8};
    int n = sizeof(arr) / sizeof(arr[0]);
    int total_sum = 0;

    #pragma omp parallel reduction(+:total_sum)
    {
        int id = omp_get_thread_num();
        int total_threads = omp_get_num_threads();

        int chunk = n / total_threads;
        int start = id * chunk;
        int end = (id == total_threads - 1) ? n : start + chunk;

        int local_sum = 0;

        for (int i = start; i < end; i++) {
            local_sum += arr[i];
        }

        printf("Thread %d: Intermediate Sum = %d\n", id, local_sum);

        total_sum += local_sum;
    }

    printf("Final Sum = %d\n", total_sum);
    return 0;
}



