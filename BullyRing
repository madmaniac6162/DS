import java.util.*;
public class Bully {
    static int n;
    static boolean[] active;

    static void elect(int s) {
        System.out.println("\n[ELECTION] Node " + s + " starts election");
        for (int i = s + 1; i <= n; i++) {
            if (active[i]) {
                System.out.println("Node " + s + " -> ELECTION -> Node " + i);
                System.out.println("Node " + i + " -> OK      -> Node " + s);
                elect(i);
                return;
            }
        }
        System.out.println("\n*** Node " + s + " is LEADER ***");
        for (int i = 1; i <= n; i++)
            if (active[i] && i != s)
                System.out.println("Node " + s + " -> COORDINATOR -> Node " + i);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of nodes: ");
        n = sc.nextInt();
        active = new boolean[n + 1];
        Arrays.fill(active, true);
        System.out.print("Enter failed node: ");
        active[sc.nextInt()] = false;
        System.out.print("Enter node starting election: ");
        int starter = sc.nextInt();
        elect(starter);
    }
}


