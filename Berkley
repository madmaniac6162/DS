import socket, threading, datetime, time

offset = datetime.timedelta(0)

def send(sock):
    while True:
        try:
            t = (datetime.datetime.now() + offset).isoformat()
            sock.send(t.encode())
            print(f"[SENT] {t}")
            time.sleep(5)
        except: break

def receive(sock):
    global offset
    while True:
        try:
            synced = datetime.datetime.fromisoformat(sock.recv(1024).decode())
            offset = synced - datetime.datetime.now()
            print(f"[SYNCED] offset = {offset}")
        except:
            print("[DISCONNECTED]")
            break

sock = socket.socket()
sock.connect(("127.0.0.1", 8080))
print("[CONNECTED]")

threading.Thread(target=send, args=(sock,), daemon=True).start()
threading.Thread(target=receive, args=(sock,), daemon=True).start()

while True: time.sleep(1)



