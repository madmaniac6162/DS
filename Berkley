import socket, threading, datetime, time

clients = {}
lock = threading.Lock()

def handle(conn, addr):
    print(f"[+] {addr} connected")
    while True:
        try:
            with lock:
                clients[addr] = (conn, datetime.datetime.fromisoformat(conn.recv(1024).decode()))
            print(f"[TIME] {addr} -> {clients[addr][1]}")
        except:
            print(f"[-] {addr} disconnected")
            with lock: clients.pop(addr, None)
            break

def sync():
    while True:
        time.sleep(5)
        with lock:
            if not clients:
                print("[SYNC] No clients")
                continue
            diffs = [datetime.datetime.now() - t for _, t in clients.values()]
            diffs.append(datetime.timedelta(0))
            avg = sum(diffs, datetime.timedelta()) / len(diffs)
            print(f"[SYNC] avg_diff = {avg}")
            for addr, (conn, t) in clients.items():
                try:
                    conn.send((datetime.datetime.now() - (datetime.datetime.now() - t) + avg).isoformat().encode())
                    print(f"[SENT] {addr} -> corrected time")
                except:
                    print(f"[ERR] {addr}")

s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("0.0.0.0", 8080))
s.listen()
print("[SERVER] Running on port 8080")

threading.Thread(target=sync, daemon=True).start()
while True:
    conn, addr = s.accept()
    threading.Thread(target=handle, args=(conn, addr), daemon=True).start()




